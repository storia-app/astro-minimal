---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../site.config";
import { formatDate, getPosts } from "../../posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <time class="meta" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, SITE.lang)}</time>
    <div class="prose"><Content /></div>
    {post.data.tags.length > 0 && (
      <p class="tags">{post.data.tags.map((t) => <span>#{t}</span>)}</p>
    )}
  </article>
</Base>
